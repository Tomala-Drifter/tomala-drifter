# Neon Postgres (set by the Vercel Neon integration)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Password for the /tasks page
APP_PASSWORD=
# Random secret used to sign the session cookie (openssl rand -hex 32)
SESSION_SECRET=
# Bearer key for API clients (Hermes): Authorization: Bearer <TASKS_API_KEY>
TASKS_API_KEY=
# Time zone for deadlines sent without Z/offset (default Europe/Amsterdam)
APP_TIMEZONE=
