{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(/**)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npm run build)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(npm audit)",
      "Bash(npm audit *)",
      "Bash(npm ci)",
      "Bash(git stash)",
      "Bash(git stash *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(curl *localhost*)",
      "Bash(curl *127.0.0.1*)"
    ],
    "deny": [
      "Read(~/.hermes/**)",
      "Read(~/.plaud/**)",
      "Read(~/.ssh/**)",
      "Bash(git push * master)",
      "Bash(git push * master *)",
      "Bash(git push * master:*)",
      "Bash(git push * *:master)",
      "Bash(git push * HEAD:master)",
      "Bash(git push * refs/heads/master*)",
      "Bash(git push * *:refs/heads/master*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "c=$(node -e 'let d=\"\";process.stdin.on(\"data\",x=>d+=x).on(\"end\",()=>process.stdout.write(JSON.parse(d).tool_input.command||\"\"))');b=$(git -C \"$CLAUDE_PROJECT_DIR\" branch --show-current); if [ \"$b\" = master ] || printf '%s' \"$c\" | grep -qw master; then echo 'Push na master jest zablokowany - uzyj innego brancha.' >&2; exit 2; fi"
          }
        ]
      }
    ]
  }
}
